{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "files": {
    "includes": ["**", "!data", "!package-lock.json", "!test/fixtures/web"]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always"
    }
  },
  "linter": {
    "rules": {
      "preset": "recommended",
      "style": {
        "useBlockStatements": "error",
        "noNestedTernary": "error"
      },
      "suspicious": {
        "noUnusedExpressions": "error"
      },
      "complexity": {
        "useMaxParams": {
          "level": "error",
          "options": { "max": 3 }
        }
      }
    }
  }
}
