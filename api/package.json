{
  "name": "shinsters-api",
  "private": true,
  "description": "Shinsters API back-end.",
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "test": "node --test \"test/**/*.test.ts\"",
    "check": "tsc --noEmit",
    "index": "node scripts/build-index.ts",
    "search": "node scripts/search.ts",
    "lint": "biome check .",
    "format": "biome check --write .",
    "mcp": "node scripts/mcp.ts",
    "chat": "node scripts/chat.ts",
    "eval": "node scripts/eval.ts",
    "serve": "node scripts/serve.ts",
    "inspect": "npx -y @modelcontextprotocol/inspector@2.13.0 node scripts/mcp.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.6",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "hono": "^4.13.16",
    "minisearch": "^7.2.0",
    "zod": "^4.6.7"
  }
}
